# Aspirational Netlify-style header map. NOT applied by GitHub Pages.
#
# GitHub Pages ignores this file. Live responses on https://deepakv30.github.io/
# only include GitHub's HSTS (strict-transport-security). CSP, X-Frame-Options,
# X-Content-Type-Options, Referrer-Policy, and Permissions-Policy below do NOT
# protect production until the site is fronted by Cloudflare, Netlify, or
# another CDN that honors `_headers` (or equivalent page rules).
#
# Keep this file as the policy we would enforce behind that CDN.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  # CSP is intentionally permissive to allow:
  # - inline styles/scripts for dark mode toggle + smooth scroll
  # - Plausible analytics
  # - FormSubmit.co for contact (no account)
  # - External Medium images in blog + bootstrap CDN fallbacks if any
  Content-Security-Policy: default-src 'self' https:; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://plausible.io https://formsubmit.co; style-src 'self' 'unsafe-inline' https:; img-src 'self' https: data:; font-src 'self' https:; connect-src 'self' https://plausible.io https://formsubmit.co; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://formsubmit.co;
